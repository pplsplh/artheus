# Telegram (dari @BotFather)
TELEGRAM_BOT_TOKEN=
# String acak bebas (huruf, angka, _ dan -), dipakai saat setWebhook
TELEGRAM_WEBHOOK_SECRET=
# Chat ID-mu. Kosongkan dulu, bot akan memberitahu ID-mu saat pertama kali di-chat
TELEGRAM_ALLOWED_CHAT_ID=

# Google Tasks (dari Google Cloud Console + OAuth Playground)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Opsional: ID list tertentu. Default: list utama
GOOGLE_TASKLIST_ID=

# Claude API (console.anthropic.com)
ANTHROPIC_API_KEY=
# Opsional
ANTHROPIC_MODEL=claude-haiku-5-5

# Vercel otomatis mengirim header "Authorization: Bearer <CRON_SECRET>" ke cron
CRON_SECRET=
