+/**
+ * DAFTAR DAILY QUEST — edit file ini untuk mengubah rutinitasmu.
+ *
+ * days: hari aktif, 0 = Minggu, 1 = Senin, ... 6 = Sabtu. Kosongkan (atau hapus) = setiap hari.
+ * xp:   hadiah saat selesai. Patokan: 10 ringan, 15 sedang, 25 berat.
+ * id:   huruf kecil tanpa spasi, maksimal 20 karakter. Jangan diganti setelah dipakai,
+ *       karena riwayat dan XP tersimpan berdasarkan id.
+ */
+
+export const STATS = {
+  STR: { name: "Strength", color: "#FF5C6C" },
+  AGI: { name: "Agility", color: "#FFB547" },
+  INT: { name: "Intelligence", color: "#A594FF" },
+  VIT: { name: "Vitality", color: "#3DDBB0" },
+  SEN: { name: "Sense", color: "#5CC8FF" },
+} as const;
+
+export type Stat = keyof typeof STATS;
+
+export type Quest = {
+  id: string;
+  title: string;
+  stat: Stat;
+  target?: string;
+  days?: number[];
+  xp: number;
+};
+
+export const QUESTS: Quest[] = [
+  { id: "sleep", title: "Tidur sebelum jam 23.00", stat: "VIT", xp: 15 },
+  { id: "water", title: "Minum air", target: "2 L", stat: "VIT", xp: 10 },
+  { id: "pushup", title: "Push-up", target: "20 rep", stat: "STR", xp: 15 },
+  { id: "cardio", title: "Jalan cepat atau lari", target: "30 menit", stat: "AGI", days: [1, 3, 5], xp: 20 },
+  { id: "sempro", title: "Kerjakan proposal sempro", target: "45 menit", stat: "INT", days: [1, 2, 3, 4, 5], xp: 25 },
+  { id: "nihongo", title: "Latihan bahasa Jepang", target: "20 menit", stat: "SEN", xp: 20 },
+];
+
+/** Hari aktif quest untuk tanggal YYYY-MM-DD */
+export function questsFor(ymd: string): Quest[] {
+  const dow = new Date(`${ymd}T00:00:00Z`).getUTCDay();
+  return QUESTS.filter((q) => !q.days?.length || q.days.includes(dow));
+}
+
+export const questById = (id: string) => QUESTS.find((q) => q.id === id);
+
+/** Porsi quest yang harus selesai supaya streak hari itu aman */
+export const CLEAR_RATIO = 0.6;
+export const clearTarget = (scheduled: number) => (scheduled ? Math.ceil(scheduled * CLEAR_RATIO) : 0);
diff --git a/lib/redis.ts b/lib/redis.ts
new file mode 100644
index 0000000..6347a7d
--- /dev/null
+++ b/lib/redis.ts
@@ -0,0 +1,100 @@
+/**
+ * Klien Upstash Redis lewat REST (tanpa dependency).
+ * Env diisi otomatis oleh integrasi Upstash di Vercel Marketplace:
+ *   UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN, atau KV_REST_API_URL + KV_REST_API_TOKEN.
+ * Kalau env kosong dan bukan production, pakai memori lokal (untuk `npm run dev`).
+ */
+
+type Cmd = (string | number)[];
+
+const url = () => process.env.UPSTASH_REDIS_REST_URL || process.env.KV_REST_API_URL || "";
+const token = () => process.env.UPSTASH_REDIS_REST_TOKEN || process.env.KV_REST_API_TOKEN || "";
+
+export function redisConfigured(): boolean {
+  return Boolean(url() && token());
+}
+
+/** Jalankan beberapa perintah sekaligus. Hasil sesuai urutan perintah. */
+export async function pipeline(cmds: Cmd[]): Promise<unknown[]> {
+  if (!cmds.length) return [];
+  if (!redisConfigured()) {
+    if (process.env.NODE_ENV === "production") {
+      throw new Error("Redis belum disambungkan: isi UPSTASH_REDIS_REST_URL dan UPSTASH_REDIS_REST_TOKEN");
+    }
+    return cmds.map(memory);
+  }
+
+  const res = await fetch(`${url()}/pipeline`, {
+    method: "POST",
+    headers: { Authorization: `Bearer ${token()}`, "Content-Type": "application/json" },
+    body: JSON.stringify(cmds.map((c) => c.map(String))),
+    cache: "no-store",
+  });
+  if (!res.ok) throw new Error(`Redis ${res.status}: ${await res.text()}`);
+  const data = (await res.json()) as { result?: unknown; error?: string }[];
+  const failed = data.find((d) => d.error);
+  if (failed) throw new Error(`Redis: ${failed.error}`);
+  return data.map((d) => d.result);
+}
+
+export async function cmd(c: Cmd): Promise<unknown> {
+  return (await pipeline([c]))[0];
+}
+
+/** Ubah balasan HGETALL (array datar [k, v, k, v]) jadi object */
+export function toHash(raw: unknown): Record<string, string> {
+  const out: Record<string, string> = {};
+  if (Array.isArray(raw)) {
+    for (let i = 0; i + 1 < raw.length; i += 2) out[String(raw[i])] = String(raw[i + 1]);
+  } else if (raw && typeof raw === "object") {
+    for (const [k, v] of Object.entries(raw)) out[k] = String(v);
+  }
+  return out;
+}
+
+// ---------- Penyimpanan memori untuk dev lokal ----------
+const g = globalThis as unknown as { __questMem?: Map<string, string | Map<string, string>> };
+const mem = (g.__questMem ??= new Map());
+
+function hashOf(key: string): Map<string, string> {
+  let h = mem.get(key);
+  if (!(h instanceof Map)) {
+    h = new Map();
+    mem.set(key, h);
+  }
+  return h;
+}
+
+function memory(c: Cmd): unknown {
+  const [op, key, ...a] = c.map(String);
+  switch (op.toUpperCase()) {
+    case "GET": {
+      const v = mem.get(key);
+      return typeof v === "string" ? v : null;
+    }
+    case "SET":
+      mem.set(key, a[0]);
+      return "OK";
+    case "SETNX":
+      if (mem.has(key)) return 0;
+      mem.set(key, a[0]);
+      return 1;
+    case "HGETALL":
+      return [...hashOf(key).entries()].flat();
+    case "HGET":
+      return hashOf(key).get(a[0]) ?? null;
+    case "HSET":
+      for (let i = 0; i + 1 < a.length; i += 2) hashOf(key).set(a[i], a[i + 1]);
+      return 1;
+    case "HDEL":
+      return a.filter((f) => hashOf(key).delete(f)).length;
+    case "HINCRBY": {
+      const h = hashOf(key);
+      const n = Number(h.get(a[0]) ?? 0) + Number(a[1]);
+      h.set(a[0], String(n));
+      return n;
+    }
+    default:
+      throw new Error(`Perintah ${op} belum didukung di memori lokal`);
+  }
+}
